@using ReShareBlazorApp.Web.Models

@* Karta ogłoszenia: na górze zdjęcie, pod nim nazwa, cena i miejscowość *@
<a class="rs-card" href="/ogloszenie/@Item.Id" aria-label="@Item.Name">
    <div class="rs-card-img">
        @if (string.IsNullOrWhiteSpace(Item.ImageUrl))
        {
            <div class="rs-card-noimg" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m21 16-5-5-8 9" /></svg>
            </div>
        }
        else
        {
            <img src="@Item.ImageUrl" alt="@Item.Name" loading="lazy" draggable="false" />
        }
        @if (Item.IsService)
        {
            <span class="rs-card-badge">Usługa</span>
        }
    </div>
    <div class="rs-card-body">
        <h3 class="rs-card-title">@Item.Name</h3>
        <p class="rs-card-price">@Item.PriceLabel</p>
        @if (!string.IsNullOrWhiteSpace(Item.City) || !string.IsNullOrWhiteSpace(Item.Condition))
        {
            <p class="rs-card-meta">@Meta</p>
        }
    </div>
</a>

@code {
    // Ogłoszenie, które karta ma pokazać (przekazywane z komponentu nadrzędnego)
    [Parameter, EditorRequired]
    public ListingItem Item { get; set; } = default!;

    // Linia pod ceną: miejscowość i (dla przedmiotów) stan, np. "Kraków · Używany"
    private string Meta => string.Join(" · ", new[] { Item.City, Item.Condition }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
