@page "/login"
@rendermode InteractiveServer

<PageTitle>Logowanie – ReShare</PageTitle>

<div class="rs-auth">
    <div class="rs-auth-card">
        <h1>Zaloguj się</h1>
        <p class="rs-auth-sub">Witaj z powrotem w ReShare.</p>

        @* Błąd logowania – serwer przekierowuje na /login?error=1 *@
        @if (Error == "1")
        {
            <div class="rs-alert">Nieprawidłowy e-mail lub hasło.</div>
        }

        @* Formularz wysyła dane do endpointu /auth/login (AuthEndpoints.cs) *@
        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <div class="rs-field">
                <label for="login-email">E-mail</label>
                <input id="login-email" class="rs-input" name="Email" type="email" placeholder="jan@przyklad.pl" required />
            </div>
            <div class="rs-field">
                <label for="login-password">Hasło</label>
                <input id="login-password" class="rs-input" name="Password" type="password" placeholder="Wpisz hasło" required />
            </div>
            <button class="rs-auth-btn" type="submit">Zaloguj się</button>
        </form>

        <p class="rs-auth-foot">Nie masz konta? <a href="/register">Zarejestruj się</a></p>
    </div>
</div>

@code {
    // Wartość z adresu, np. /login?error=1
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
